{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/driver-compliance-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/compliance-early-warning",
      "schedule": "0 8 * * *"
    }
  ]
}
