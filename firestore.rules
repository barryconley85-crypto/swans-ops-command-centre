rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function lead() { return signedIn() && request.auth.token.email == 'bc@swanstravel.com'; }
    function approved() { return signedIn() && (lead() || exists(/databases/$(database)/documents/ops_invites/$(request.auth.token.email))); }
    function member() { return approved() && exists(/databases/$(database)/documents/ops_members/$(request.auth.uid)) && get(/databases/$(database)/documents/ops_members/$(request.auth.uid)).data.status == 'active'; }
    function memberRole() { return get(/databases/$(database)/documents/ops_members/$(request.auth.uid)).data.memberRole; }
    function operationsManager() { return member() && ['lead', 'manager'].hasAny([memberRole()]); }
    function sharedEditor() { return member() && ['lead', 'manager', 'coordinator', 'dispatcher'].hasAny([memberRole()]); }
    function onCallResponder() { return member() && ['lead', 'manager', 'coordinator', 'dispatcher', 'on_call', 'support'].hasAny([memberRole()]); }
    function currentMemberId() { return get(/databases/$(database)/documents/ops_members/$(request.auth.uid)).data.id; }
    match /ops_invites/{email} {
      allow get: if signedIn() && (lead() || request.auth.token.email == email);
      allow list, create, update, delete: if lead();
    }
    match /ops_members/{memberId} {
      allow read: if member() || lead();
      allow create: if signedIn() && memberId == request.auth.uid && approved() && request.resource.data.userId == request.auth.uid;
      allow update: if lead() || (member() && memberId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['initials', 'colour', 'updatedAt']));
      allow delete: if lead();
    }
    match /ops_tasks/{taskId} {
      allow read: if member();
      allow create, delete: if operationsManager();
      allow update: if operationsManager() || (onCallResponder() && resource.data.assignedEmail == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedReason', 'completedAt', 'completedByTeamMemberId', 'completedByUserId', 'completedByName', 'updatedAt']) && ((request.resource.data.status == 'complete' && request.resource.data.completedByUserId == request.auth.uid && request.resource.data.completedByTeamMemberId == get(/databases/$(database)/documents/ops_members/$(request.auth.uid)).data.id && request.resource.data.completedByName == get(/databases/$(database)/documents/ops_members/$(request.auth.uid)).data.displayName) || (request.resource.data.status != 'complete' && request.resource.data.completedAt == null && request.resource.data.completedByTeamMemberId == null && request.resource.data.completedByUserId == null && request.resource.data.completedByName == null)));
    }
    match /ops_task_activity/{activityId} { allow read: if member(); allow create: if sharedEditor() && request.resource.data.actorUserId == request.auth.uid; allow update, delete: if false; }
    match /ops_templates/{templateId} { allow read: if member(); allow write: if operationsManager(); }
    match /ops_rota/{rotaId} { allow read: if member(); allow write: if operationsManager(); }
    match /ops_handovers/{handoverId} { allow read: if member(); allow create, update: if sharedEditor(); allow delete: if lead(); }
    match /ops_issues/{issueId} { allow read: if member(); allow create, update: if sharedEditor(); allow delete: if lead(); }
    match /ops_readiness/{pulseId} { allow read: if member(); allow create, update: if onCallResponder() && request.resource.data.userId == request.auth.uid; allow delete: if lead(); }
    match /ops_performance_notes/{noteId} { allow read: if member(); allow write: if lead(); }
    match /ops_chat_messages/{messageId} { allow read: if member(); allow create: if onCallResponder() && request.resource.data.authorUserId == request.auth.uid; allow update: if false; allow delete: if lead(); }
    match /ops_notifications/{notificationId} { allow read: if member() && resource.data.recipientEmail == request.auth.token.email; allow create: if lead(); allow update: if member() && resource.data.recipientEmail == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'updatedAt']); allow delete: if lead(); }
    match /ops_on_call_items/{itemId} { allow read: if member(); allow create, update: if onCallResponder(); allow delete: if lead(); }
    match /ops_help_requests/{requestId} {
      allow read: if member();
      allow create: if onCallResponder() && request.resource.data.requestedByUserId == request.auth.uid;
      allow update: if sharedEditor() || (onCallResponder() && (
        (resource.data.status == 'open' && request.resource.data.status == 'acknowledged' && request.resource.data.ownerTeamMemberId == currentMemberId() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerTeamMemberId', 'acknowledgedAt', 'acknowledgedByUserId', 'updatedAt'])) ||
        (request.resource.data.status == 'resolved' && (resource.data.requestedByUserId == request.auth.uid || resource.data.ownerTeamMemberId == currentMemberId()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'resolvedAt', 'resolvedByUserId', 'updatedAt']))
      ));
      allow delete: if lead();
    }
    match /ops_shift_prompts/{promptId} { allow read: if member(); allow create, update: if onCallResponder() && request.resource.data.userId == request.auth.uid; allow delete: if lead(); }
    match /ops_presence/{userId} { allow read: if member(); allow create, update: if member() && userId == request.auth.uid && request.resource.data.userId == request.auth.uid; allow delete: if false; }
    match /ops_report_views/{viewId} { allow read, write: if lead(); }
  }
}
